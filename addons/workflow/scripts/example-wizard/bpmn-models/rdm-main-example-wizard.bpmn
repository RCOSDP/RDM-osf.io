<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns:flowable="http://flowable.org/bpmn"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
  typeLanguage="http://www.w3.org/2001/XMLSchema"
  expressionLanguage="http://www.w3.org/1999/XPath"
  targetNamespace="http://www.flowable.org/processdef">

  <process id="rdm-main-example-wizard" name="RDM Form Extensions Example" isExecutable="true">

    <startEvent id="startEvent" flowable:initiator="initiator" flowable:formKey="example-start-form">
    </startEvent>

    <userTask id="wizardTask" name="Wizard Form Example" flowable:assignee="executor" flowable:formKey="example-wizard-form">
    </userTask>

    <scriptTask id="buildSummary" name="Build summary" scriptFormat="groovy" flowable:autoStoreVariables="false">
      <script><![CDATA[
import com.fasterxml.jackson.databind.ObjectMapper
import com.fasterxml.jackson.databind.SerializationFeature
import com.fasterxml.jackson.databind.node.ObjectNode

def mapper = new ObjectMapper()
mapper.enable(SerializationFeature.INDENT_OUTPUT)

def summary = mapper.createObjectNode()

// Start form variables
def startForm = summary.putObject("startForm")
['project_metadata', 'project_metadata_multi', 'file_metadata', 'selected_files'].each { key ->
    def val = execution.getVariable(key)
    if (val == null) {
        startForm.putNull(key)
    } else if (val instanceof com.fasterxml.jackson.databind.JsonNode) {
        startForm.set(key, val)
    } else {
        startForm.put(key, val.toString())
    }
}

// Wizard form variables
def wizardForm = summary.putObject("wizardForm")
['export_target', 'uploaded_files', 'note', 'include_details'].each { key ->
    def val = execution.getVariable(key)
    if (val == null) {
        wizardForm.putNull(key)
    } else if (val instanceof com.fasterxml.jackson.databind.JsonNode) {
        wizardForm.set(key, val)
    } else if (val instanceof Boolean) {
        wizardForm.put(key, (boolean) val)
    } else {
        wizardForm.put(key, val.toString())
    }
}

def members = execution.getVariable("members")
if (members instanceof com.fasterxml.jackson.databind.JsonNode) {
    wizardForm.set("members", members)
} else if (members != null) {
    wizardForm.put("members", members.toString())
} else {
    wizardForm.putNull("members")
}

execution.setVariable('_submittedDataSummary', mapper.writeValueAsString(summary))
]]></script>
    </scriptTask>

    <userTask id="resultTask" name="Submitted Data" flowable:assignee="executor" flowable:formKey="example-result-form">
    </userTask>

    <endEvent id="endEvent"></endEvent>

    <sequenceFlow id="flowStartToWizard" sourceRef="startEvent" targetRef="wizardTask"></sequenceFlow>
    <sequenceFlow id="flowWizardToBuild" sourceRef="wizardTask" targetRef="buildSummary"></sequenceFlow>
    <sequenceFlow id="flowBuildToResult" sourceRef="buildSummary" targetRef="resultTask"></sequenceFlow>
    <sequenceFlow id="flowResultToEnd" sourceRef="resultTask" targetRef="endEvent"></sequenceFlow>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_rdm-main-example-wizard">
    <bpmndi:BPMNPlane bpmnElement="rdm-main-example-wizard" id="BPMNPlane_rdm-main-example-wizard">
      <bpmndi:BPMNShape bpmnElement="startEvent" id="BPMNShape_startEvent">
        <omgdc:Bounds height="30.0" width="30.0" x="100.0" y="163.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="wizardTask" id="BPMNShape_wizardTask">
        <omgdc:Bounds height="80.0" width="100.0" x="210.0" y="138.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="buildSummary" id="BPMNShape_buildSummary">
        <omgdc:Bounds height="80.0" width="100.0" x="390.0" y="138.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="resultTask" id="BPMNShape_resultTask">
        <omgdc:Bounds height="80.0" width="100.0" x="570.0" y="138.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="endEvent" id="BPMNShape_endEvent">
        <omgdc:Bounds height="28.0" width="28.0" x="750.0" y="164.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="flowStartToWizard" id="BPMNEdge_flowStartToWizard">
        <omgdi:waypoint x="130.0" y="178.0"></omgdi:waypoint>
        <omgdi:waypoint x="210.0" y="178.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowWizardToBuild" id="BPMNEdge_flowWizardToBuild">
        <omgdi:waypoint x="310.0" y="178.0"></omgdi:waypoint>
        <omgdi:waypoint x="390.0" y="178.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowBuildToResult" id="BPMNEdge_flowBuildToResult">
        <omgdi:waypoint x="490.0" y="178.0"></omgdi:waypoint>
        <omgdi:waypoint x="570.0" y="178.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flowResultToEnd" id="BPMNEdge_flowResultToEnd">
        <omgdi:waypoint x="670.0" y="178.0"></omgdi:waypoint>
        <omgdi:waypoint x="750.0" y="178.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
