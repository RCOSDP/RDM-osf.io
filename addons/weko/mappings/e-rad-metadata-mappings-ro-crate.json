{
    "@metadata": {
        "filename": "ro-crate-metadata.json"
    },
    "@files": {
        "@type": "object",
        "file[]": {
            ".@type": "File",
            "name": "{{object_filename}}",
            "jpcoar:mimeType": "{{object_format}}",
            "jpcoar:format": "preview"
        }
    },
    "@projects": {
        "@type": "object",
        "root.jpcoar:fundingReference[]": {
            ".@type": "PropertyValue",
            "jpcoar:funderIdentifier": {
                "@createIf": "{{ funder_value }}",
                ".@type": "jpcoar:funderIdentifier",
                "jpcoar:funderIdentifierType": "e-Rad_funder",
                "value": "{{funder_value}}"
            },
            "jpcoar:funderName[FUNDER_NAME_JA]": {
                "@createIf": "{{ funder_value }}",
                ".@type": "PropertyValue",
                "value": "{{funder_tooltip_0}}({{funder_value}})",
                "language": "ja"
            },
            "jpcoar:funderName[FUNDER_NAME_EN]": {
                "@createIf": "{{ funder_value }}",
                ".@type": "PropertyValue",
                "value": "{{funder_tooltip_1}}({{funder_value}})",
                "language": "en"
            },
            "jpcoar:fundingStreamIdentifier": {
                "@createIf": "{{ funding_stream_code_value }}",
                ".@type": "jpcoar:fundingStreamIdentifier",
                "value": "{{funding_stream_code_value}}",
                "jpcoar:fundingStreamIdentifierType": "JGN_fundingStream"
            },
            "jpcoar:fundingStream[FUNDING_STREAM_JA]": {
                "@createIf": "{{ program_name_ja_value }}",
                ".@type": "PropertyValue",
                "value": "{{program_name_ja_value}}",
                "language": "ja"
            },
            "jpcoar:fundingStream[FUNDING_STREAM_EN]": {
                "@createIf": "{{ program_name_en_value }}",
                ".@type": "PropertyValue",
                "value": "{{program_name_en_value}}",
                "language": "en"
            },
            "jpcoar:awardNumber": {
                "@createIf": "{{ japan_grant_number_value }}",
                ".@type": "jpcoar:awardNumber",
                "jpcoar:awardNumberType": "JGN",
                "value": "{{japan_grant_number_value}}"
            },
            "jpcoar:awardTitle[PROJECT_NAME_JA]": {
                "@createIf": "{{ project_name_ja_value }}",
                ".@type": "PropertyValue",
                "language": "ja",
                "value": "{{project_name_ja_value}}"
            },
            "jpcoar:awardTitle[PROJECT_NAME_EN]": {
                "@createIf": "{{ project_name_en_value }}",
                ".@type": "PropertyValue",
                "language": "en",
                "value": "{{project_name_en_value}}"
            }
        }
    },
    "grdm-file:data-number": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value != \"manuscript\" %}{{value}}{% endif %}"
    },
    "grdm-file:title-ja": {
        "@type": "string",
        "@createIf": "{{value}}",
        "root.dc:title[TITLE_JA]": {
            ".@type": "PropertyValue",
            "value": "{{value}}",
            "language": "ja"
        }
    },
    "grdm-file:title-en": {
        "@type": "string",
        "@createIf": "{{value}}",
        "root.dc:title[TITLE_EN]": {
            ".@type": "PropertyValue",
            "value": "{{value}}",
            "language": "en"
        }
    },
    "grdm-file:date-issued-updated": null,
    "grdm-file:data-description-ja": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value != \"manuscript\" %}{{value}}{% endif %}",
        "root.datacite:description[ABSTRACT_JA]": {
            ".@type": "PropertyValue",
            "descriptionType": "Abstract",
            "value": "{{value}}",
            "language": "ja"
        }
    },
    "grdm-file:data-description-en": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value != \"manuscript\" %}{{value}}{% endif %}",
        "root.datacite:description[ABSTRACT_EN]": {
            ".@type": "PropertyValue",
            "descriptionType": "Abstract",
            "value": "{{value}}",
            "language": "en"
        }
    },
    "grdm-file:data-research-field": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value != \"manuscript\" %}{{grdm_file_data_research_field_value}}{{project_research_field_value}}{% endif %}",
        "root.jpcoar:subject[RESEARCH_FIELD_JA]": {
            "@createIf": "{% if grdm_file_data_research_field_value != \"project\" %}{{grdm_file_data_research_field_tooltip_0}}{% else %}{{project_research_field_tooltip_0}}{% endif %}",
            ".@type": "PropertyValue",
            "value": "{% if grdm_file_data_research_field_value != \"project\" %}{{grdm_file_data_research_field_tooltip_0}}{% else %}{{project_research_field_tooltip_0}}{% endif %}",
            "language": "ja",
            "subjectScheme": "e-Rad_field"
        },
        "root.jpcoar:subject[RESEARCH_FIELD_EN]": {
            "@createIf": "{% if grdm_file_data_research_field_value != \"project\" %}{{grdm_file_data_research_field_tooltip_1}}{% else %}{{project_research_field_tooltip_1}}{% endif %}",
            ".@type": "PropertyValue",
            "value": "{% if grdm_file_data_research_field_value != \"project\" %}{{grdm_file_data_research_field_tooltip_1}}{% else %}{{project_research_field_tooltip_1}}{% endif %}",
            "language": "en",
            "subjectScheme": "e-Rad_field"
        }
    },
    "grdm-file:data-type": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value != \"manuscript\" %}{{value}}{% endif %}",
        "root.dc:type": {
            ".@type": "PropertyValue",
            "value": "{{ value }}",
            "rdf:resource": "{{ value | to_resource_type_uri }}"
        }
    },
    "grdm-file:file-size": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value != \"manuscript\" %}{{value}}{% endif %}"
    },
    "grdm-file:data-policy-free": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value != \"manuscript\" %}{{value}}{% endif %}",
        "root.dc:rights[RIGHTS_TEXT_JA]": {
            ".@type": "PropertyValue",
            "value": "{{tooltip_0}}",
            "language": "ja"
        },
        "root.dc:rights[RIGHTS_TEXT_EN]": {
            ".@type": "PropertyValue",
            "value": "{{tooltip_1}}",
            "language": "en"
        }
    },
    "grdm-file:data-policy-license": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value != \"manuscript\" %}{{value}}{% endif %}",
        "root.dc:rights[RIGHTS_JA]": {
            "@createIf": "{{ value }}",
            ".@type": "PropertyValue",
            "value": "{{ (value | to_normalized_ja_license_name_for_jpcoar2) or tooltip_0 or value }}",
            "language": "ja",
            "rdf:resource": "{{ value | to_license_url_for_jpcoar2 or '' }}"
        },
        "root.dc:rights[RIGHTS_EN]": {
            "@createIf": "{{ value }}",
            ".@type": "PropertyValue",
            "value": "{{ (value | to_normalized_en_license_name_for_jpcoar2) or tooltip_1 or value }}",
            "language": "en",
            "rdf:resource": "{{ value | to_license_url_for_jpcoar2 or '' }}"
        }
    },
    "grdm-file:data-policy-cite-ja": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value != \"manuscript\" %}{{value}}{% endif %}",
        "root.dc:rights[CITATION_JA]": {
            ".@type": "PropertyValue",
            "value": "{{value}}",
            "language": "ja"
        }
    },
    "grdm-file:data-policy-cite-en": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value != \"manuscript\" %}{{value}}{% endif %}",
        "root.dc:rights[CITATION_EN]": {
            ".@type": "PropertyValue",
            "value": "{{value}}",
            "language": "en"
        }
    },
    "grdm-file:access-rights": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value != \"manuscript\" %}{{value}}{% endif %}",
        "root.dcterms:accessRights[]": {
            ".@type": "PropertyValue",
            "value": "{{ value }}",
            "rdf:resource": "{{ value | to_access_rights_uri or '' }}"
        }
    },
    "grdm-file:available-date": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value != \"manuscript\" %}{{value}}{% endif %}",
        "root.datacite:date[AVAILABLE]": {
            ".@type": "Date",
            "value": "{{value}}",
            "dateType": "Available"
        }
    },
    "grdm-file:repo-information-ja": null,
    "grdm-file:repo-information-en": null,
    "grdm-file:repo-url-doi-link": null,
    "grdm-file:doi": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value == \"manuscript\" %}{{value}}{% endif %}",
        "root.jpcoar:relation[]": {
            ".@type": "PropertyValue",
            "jpcoar:relationType": "{% if grdm_file_version_value == 'VoR' %}isIdenticalTo{% else %}isVersionOf{% endif %}",
            "jpcoar:relatedIdentifier": {
                ".@type": "PropertyValue",
                "identifierType": "DOI",
                "value": "https://doi.org/{{value}}"
            }
        }
    },
    "grdm-file:manuscript-type": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value == \"manuscript\" %}{{value}}{% endif %}",
        "root.dc:type": {
            ".@type": "PropertyValue",
            "value": "{{value}}",
            "rdf:resource": "{{value | to_manuscript_type_uri}}"
        }
    },
    "grdm-file:authors": {
        "@type": "array",
        "@createIf": "{% if grdm_file_file_type_value == \"manuscript\" %}true{% endif %}",
        "root.jpcoar:creator[]": {
            ".@type": "Person",
            "jpcoar:nameIdentifier[]": {
                "@createIf": "{{object_number}}",
                ".@type": "Person",
                "value": "{{object_number}}",
                "nameIdentifierScheme": "e-Rad_Researcher"
            },
            "jpcoar:creatorName[CREATOR_NAME_JA]": {
                "@createIf": "{{object_name_ja_last}}{{object_name_ja_middle}}{{object_name_ja_first}}",
                ".@type": "Person",
                "value": "{{object_name_ja_last}}, {{object_name_ja_middle}}{% if object_name_ja_middle %} {% endif %}{{object_name_ja_first}}",
                "language": "ja"
            },
            "jpcoar:creatorName[CREATOR_NAME_EN]": {
                "@createIf": "{{object_name_en_last}}{{object_name_en_middle}}{{object_name_en_first}}",
                ".@type": "Person",
                "value": "{{object_name_en_last}}, {{object_name_en_middle}}{% if object_name_en_middle %} {% endif %}{{object_name_en_first}}",
                "language": "en"
            },
            "jpcoar:familyName[FAMILY_NAME_JA]": {
                "@createIf": "{{object_name_ja_last}}",
                ".@type": "Person",
                "value": "{{object_name_ja_last}}",
                "language": "ja"
            },
            "jpcoar:familyName[FAMILY_NAME_EN]": {
                "@createIf": "{{object_name_en_last}}",
                ".@type": "Person",
                "value": "{{object_name_en_last}}",
                "language": "en"
            },
            "jpcoar:givenName[GIVEN_NAME_JA]": {
                "@createIf": "{{object_name_ja_middle}}{{object_name_ja_first}}",
                ".@type": "Person",
                "value": "{{object_name_ja_middle}}{% if object_name_ja_middle %} {% endif %}{{object_name_ja_first}}",
                "language": "ja"
            },
            "jpcoar:givenName[GIVEN_NAME_EN]": {
                "@createIf": "{{object_name_en_middle}}{{object_name_en_first}}",
                ".@type": "Person",
                "value": "{{object_name_en_middle}}{% if object_name_en_middle %} {% endif %}{{object_name_en_first}}",
                "language": "en"
            }
        }
    },
    "grdm-file:journal-name-ja": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value == \"manuscript\" %}{{value}}{% endif %}",
        "root.jpcoar:sourceTitle[SOURCE_TITLE_JA]": {
            ".@type": "PropertyValue",
            "value": "{{value}}",
            "language": "ja"
        }
    },
    "grdm-file:journal-name-en": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value == \"manuscript\" %}{{value}}{% endif %}",
        "root.jpcoar:sourceTitle[SOURCE_TITLE_EN]": {
            ".@type": "PropertyValue",
            "value": "{{value}}",
            "language": "en"
        }
    },
    "grdm-file:date-published": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value == \"manuscript\" %}{{value}}{% endif %}",
        "root.datacite:date[ISSUED]": {
            ".@type": "Date",
            "value": "{{value}}",
            "dateType": "Issued"
        }
    },
    "grdm-file:volume": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value == \"manuscript\" %}{{value}}{% endif %}",
        "root.jpcoar:volume": {
            ".@type": "PropertyValue",
            "value": "{{value}}"
        }
    },
    "grdm-file:issue": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value == \"manuscript\" %}{{value}}{% endif %}",
        "root.jpcoar:issue": {
            ".@type": "PropertyValue",
            "value": "{{value}}"
        }
    },
    "grdm-file:page-start": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value == \"manuscript\" %}{{value}}{% endif %}",
        "root.jpcoar:pageStart": {
            ".@type": "PropertyValue",
            "value": "{{value}}"
        }
    },
    "grdm-file:page-end": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value == \"manuscript\" %}{{value}}{% endif %}",
        "root.jpcoar:pageEnd": {
            ".@type": "PropertyValue",
            "value": "{{value}}"
        }
    },
    "grdm-file:version grdm-file:reviewed": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value == \"manuscript\" %}{{grdm_file_version_value}}{% endif %}",
        "root.oaire:version": {
            ".@type": "PropertyValue",
            "value": "{{grdm_file_version_value}}",
            "rdf:resource": "{{grdm_file_version_value | to_version_type_uri}}",
            "itemReviewed": "{% if grdm_file_reviewed_value == \"yes\" %}Peer reviewed{% else %}Not peer reviewed{% endif %}"
        }
    },
    "grdm-file:publication-link": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value != \"manuscript\" %}{{value}}{% endif %}",
        "root.jpcoar:relation[]": {
            ".@type": "PropertyValue",
            "jpcoar:relationType": "isSupplementTo",
            "jpcoar:relatedIdentifier": {
                ".@type": "PropertyValue",
                "identifierType": "DOI",
                "value": "https://doi.org/{{value}}"
            }
        }
    },
    "grdm-file:dataset-link": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value == \"manuscript\" %}{{value}}{% endif %}",
        "root.jpcoar:relation[]": {
            ".@type": "PropertyValue",
            "jpcoar:relationType": "isSupplementedBy",
            "jpcoar:relatedIdentifier": {
                ".@type": "PropertyValue",
                "identifierType": "DOI",
                "value": "https://doi.org/{{value}}"
            }
        }
    },
    "grdm-file:creators": {
        "@type": "array",
        "@createIf": "{% if grdm_file_file_type_value != \"manuscript\" %}true{% endif %}",
        "root.jpcoar:creator[]": {
            ".@type": "Person",
            "jpcoar:nameIdentifier[]": {
                "@createIf": "{{object_number}}",
                ".@type": "Person",
                "value": "{{object_number}}",
                "nameIdentifierScheme": "e-Rad_Researcher"
            },
            "jpcoar:creatorName[CREATOR_NAME_JA]": {
                "@createIf": "{{object_name_ja}}",
                ".@type": "Person",
                "value": "{{object_name_ja}}",
                "language": "ja"
            },
            "jpcoar:creatorName[CREATOR_NAME_EN]": {
                "@createIf": "{{object_name_en}}",
                ".@type": "Person",
                "value": "{{object_name_en}}",
                "language": "en"
            }
        }
    },
    "grdm-file:hosting-inst-ja": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value != \"manuscript\" %}{{value}}{% endif %}",
        "root.jpcoar:contributor[HOSTING_INSTITUTION]": {
            ".@type": "Organization",
            "additionalType": {
                ".@id": "https://github.com/JPCOAR/schema/blob/master/2.0/#HostingInstitution"
            },
            "jpcoar:contributorType": "HostingInstitution",
            "jpcoar:contributorName[HOSTING_INSTITUTION_JA]": {
                "@createIf": "{{value}}",
                ".@type": "Organization",
                "value": "{{value}}",
                "language": "ja",
                "nameType": "Organizational"
            }
        }
    },
    "grdm-file:hosting-inst-en": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value != \"manuscript\" %}{{value}}{% endif %}",
        "root.jpcoar:contributor[HOSTING_INSTITUTION]": {
            ".@type": "Organization",
            "additionalType": {
                ".@id": "https://github.com/JPCOAR/schema/blob/master/2.0/#HostingInstitution"
            },
            "jpcoar:contributorType": "HostingInstitution",
            "jpcoar:contributorName[HOSTING_INSTITUTION_EN]": {
                "@createIf": "{{value}}",
                ".@type": "Organization",
                "value": "{{value}}",
                "language": "en",
                "nameType": "Organizational"
            }
        }
    },
    "grdm-file:hosting-inst-id": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value != \"manuscript\" %}{{value}}{% endif %}",
        "root.jpcoar:contributor[HOSTING_INSTITUTION]": {
            ".@type": "Organization",
            "additionalType": {
                ".@id": "https://github.com/JPCOAR/schema/blob/master/2.0/#HostingInstitution"
            },
            "jpcoar:contributorType": "HostingInstitution",
            "jpcoar:nameIdentifier[]": {
                ".@type": "Organization",
                "value": "{{value}}",
                "nameIdentifierScheme": "ROR"
            }
        }
    },
    "grdm-file:data-man-type": null,
    "grdm-file:data-man-number": {
        "@type": "string",
        "@createIf": "{% if grdm_file_data_man_type_value == \"individual\" and grdm_file_file_type_value != \"manuscript\" %}{{value}}{% endif %}",
        "root.jpcoar:contributor[DATA_MANAGER]": {
            ".@type": "Person",
            "additionalType": {
                ".@id": "https://github.com/JPCOAR/schema/blob/master/2.0/#DataManager"
            },
            "jpcoar:contributorType": "DataManager",
            "jpcoar:nameIdentifier[]": {
                ".@type": "Person",
                "value": "{{object_number}}",
                "nameIdentifierScheme": "e-Rad_Researcher"
            }
        }
    },
    "grdm-file:data-man-name-ja": {
        "@type": "string",
        "@createIf": "{% if grdm_file_data_man_type_value == \"individual\" and grdm_file_file_type_value != \"manuscript\" %}{{value}}{% endif %}",
        "root.jpcoar:contributor[DATA_MANAGER]": {
            ".@type": "Person",
            "additionalType": {
                ".@id": "https://github.com/JPCOAR/schema/blob/master/2.0/#DataManager"
            },
            "jpcoar:contributorType": "DataManager",
            "jpcoar:contributorName[DATA_MANAGER_JA]": {
                "@createIf": "{{value}}",
                ".@type": "Person",
                "value": "{{value}}",
                "language": "ja"
            }
        }
    },
    "grdm-file:data-man-name-en": {
        "@type": "string",
        "@createIf": "{% if grdm_file_data_man_type_value == \"individual\" and grdm_file_file_type_value != \"manuscript\" %}{{value}}{% endif %}",
        "root.jpcoar:contributor[DATA_MANAGER]": {
            ".@type": "Person",
            "additionalType": {
                ".@id": "https://github.com/JPCOAR/schema/blob/master/2.0/#DataManager"
            },
            "jpcoar:contributorType": "DataManager",
            "jpcoar:contributorName[DATA_MANAGER_EN]": {
                "@createIf": "{{value}}",
                ".@type": "Person",
                "value": "{{value}}",
                "language": "en"
            }
        }
    },
    "grdm-file:data-man-org-ja": {
        "@type": "string",
        "@createIf": "{% if grdm_file_data_man_type_value == \"organization\" and grdm_file_file_type_value != \"manuscript\" %}{{value}}{% endif %}",
        "root.jpcoar:contributor[DATA_MANAGER]": {
            ".@type": "Organization",
            "additionalType": {
                ".@id": "https://github.com/JPCOAR/schema/blob/master/2.0/#DataManager"
            },
            "jpcoar:contributorType": "DataManager",
            "jpcoar:contributorName[DATA_MANAGER_ORG_JA]": {
                "@createIf": "{{value}}",
                ".@type": "Organization",
                "value": "{{value}}",
                "language": "ja",
                "nameType": "Organizational"
            }
        }
    },
    "grdm-file:data-man-org-en": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value != \"manuscript\" and grdm_file_data_man_type_value == \"organization\" %}{{value}}{% endif %}",
        "root.jpcoar:contributor[DATA_MANAGER]": {
            ".@type": "Organization",
            "additionalType": {
                ".@id": "https://github.com/JPCOAR/schema/blob/master/2.0/#DataManager"
            },
            "jpcoar:contributorType": "DataManager",
            "jpcoar:contributorName[DATA_MANAGER_ORG_EN]": {
                "@createIf": "{{value}}",
                ".@type": "Organization",
                "value": "{{value}}",
                "language": "en",
                "nameType": "Organizational"
            }
        }
    },
    "grdm-file:data-man-address-ja grdm-file:data-man-tel grdm-file:data-man-email": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value != \"manuscript\" %}{{value}}{% endif %}",
        "root.jpcoar:contributor[CONTACT_PERSON]": {
            ".@type": "Organization",
            "additionalType": {
                ".@id": "https://github.com/JPCOAR/schema/blob/master/2.0/#ContactPerson"
            },
            "jpcoar:contributorType": "ContactPerson",
            "jpcoar:contributorName[CONTACT_PERSON_JA]": {
                "@createIf": "{{value}}",
                ".@type": "Organization",
                "value": "{{grdm_file_data_man_org_ja_value}} {{grdm_file_data_man_address_ja_value}} {% if grdm_file_data_man_tel_value %}TEL: {{grdm_file_data_man_tel_value}} {% endif %}{% if grdm_file_data_man_email_value %}E-Mail: {{grdm_file_data_man_email_value}}{% endif %}",
                "language": "ja",
                "nameType": "Organizational"
            }
        }
    },
    "grdm-file:data-man-address-en grdm-file:data-man-tel grdm-file:data-man-email": {
        "@type": "string",
        "@createIf": "{% if grdm_file_file_type_value != \"manuscript\" %}{{value}}{% endif %}",
        "root.jpcoar:contributor[CONTACT_PERSON]": {
            ".@type": "Organization",
            "additionalType": {
                ".@id": "https://github.com/JPCOAR/schema/blob/master/2.0/#ContactPerson"
            },
            "jpcoar:contributorType": "ContactPerson",
            "jpcoar:contributorName[CONTACT_PERSON_EN]": {
                "@createIf": "{{value}}",
                ".@type": "Organization",
                "value": "{{grdm_file_data_man_org_en_value}} {{grdm_file_data_man_address_en_value}} {% if grdm_file_data_man_tel_value %}TEL: {{grdm_file_data_man_tel_value}} {% endif %}{% if grdm_file_data_man_email_value %}E-Mail: {{grdm_file_data_man_email_value}}{% endif %}",
                "language": "en",
                "nameType": "Organizational"
            }
        }
    },
    "grdm-file:remarks-ja": null,
    "grdm-file:remarks-en": null,
    "grdm-file:metadata-access-rights": null,
    "@agent": {
        "@type": "object",
        "root.wk:feedbackMail[]": "{{ object_username }}"
    },
    "_": {
        "root": {
            ".@id": "./",
            ".@type": "Dataset",
            "name": "{% if grdm_file_title_en_value %}{{ grdm_file_title_en_value }}{% elif grdm_file_title_ja_value %}{{ grdm_file_title_ja_value }}{% endif %}",
            "description": "{% if grdm_file_data_description_en_value %}{{ grdm_file_data_description_en_value }}{% elif grdm_file_data_description_ja_value %}{{ grdm_file_data_description_ja_value }}{% endif %}",
            "conformsTo": {
                ".@id": "https://w3id.org/ro/crate/1.1"
            },
            "wk:publishStatus": "private",
            "wk:index": "{{ index_id }}",
            "datePublished": "{{ nowdate }}"
        },
        "ro_crate_metadata": {
            ".@id": "ro-crate-metadata.json",
            ".@type": "CreativeWork",
            "about": {
              ".@id": "./"
            },
            "conformsTo": {
              ".@id": "https://w3id.org/ro/crate/1.1"
            }
        }
    }
}
